rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------------------------------------------------------
    // products — public read (storefront + SEO), admin-only write.
    // The Translate & Save flow actually writes via the Firebase Admin
    // SDK from a trusted serverless function (which bypasses these
    // rules entirely), but we still lock down direct client writes so
    // a compromised/admin browser session can't be used to corrupt
    // catalog data outside that flow.
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // blogPosts — public read of published posts, admin-only write.
    // English-only by product policy (see /firestore-schema.md).
    // ---------------------------------------------------------------
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // orders — never client-writable. Only the Stripe webhook function
    // (via the Admin SDK, which bypasses rules) creates these. A signed-
    // in admin may read them for support/fulfillment purposes.
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // admins — membership list used by isAdmin() above. Never
    // client-writable; provision admins via the Firebase Console or
    // the Admin SDK directly (see README.md).
    // ---------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // newsletterSignups — optional collection if you wire the footer
    // newsletter form to Firestore instead of an ESP. Write-only from
    // the client (no enumeration of other people's emails).
    // ---------------------------------------------------------------
    match /newsletterSignups/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'locale', 'createdAt'])
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
